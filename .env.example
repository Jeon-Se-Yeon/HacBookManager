# Netlify Site settings > Environment variables 에 동일하게 설정하세요.
# 주의: 이 파일에는 절대 실제 값을 넣지 마세요. 실제 값은 .env(git 제외)에만 넣습니다.

# SQLite(Turso/libSQL) 데이터베이스
# - 배포: Turso DB의 URL과 토큰을 설정 (https://turso.tech 에서 무료 생성 가능)
# - 로컬 개발: 비워두면 자동으로 .data/hac-book.db SQLite 파일을 사용합니다.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# 초기 계정 (DB의 users 테이블이 비어 있을 때 1회 시드됩니다)
HAC_USERS_JSON=[{"id":"admin","name":"관리자","password":"changeme","role":"admin"}]

# 관리자 회원가입 시 필요한 코드 (미설정 시 관리자 회원가입 비활성화)
HAC_ADMIN_SIGNUP_CODE=your-admin-signup-code

# 로그인 세션 토큰 서명용 랜덤 문자열
HAC_SESSION_SECRET=your-random-secret-string
